{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv" : [
    "PORT",
    "NEXT_PUBLIC_API_URL",
    "BUCKETNAME",
    "REGION",
    "CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_SIGNING_SECRET",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "DATABASE_URL",
    "REDIS_URL",
    "QDRANT_URL",
    "QDRANT_API_KEY",
    "QDRANT_PORT",
    "QDRANT_API",
    "GOOGLE_API_KEY",
    "DEEPSEEK_API_KEY",
    "LANGSMITH_TRACING",
    "LANGSMITH_ENDPOINT",
    "LANGSMITH_API_KEY",
    "LANGSMITH_AGENT_ID",
    "LANGSMITH_AGENT_ENVIRONMENT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": true,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "persistent" : true
    },
    "db:migrate": {
      "cache": false,
      "persistent" : true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    }
  }
}
